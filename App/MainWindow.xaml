<Window x:Class="NHL27Kit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NHL27Kit.App"
        Title="HMS · Hockey Modding Suite" Icon="Assets/hms.ico" Width="1480" Height="900" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" StateChanged="OnStateChanged" Closing="OnClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearch}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.FocusSearch}" Executed="OnFocusSearch" />
    </Window.CommandBindings>

    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ============================================================ title bar -->
            <Rectangle Grid.Row="0" Height="3" VerticalAlignment="Bottom" Fill="{StaticResource RinkStripe}" IsHitTestVisible="False" Panel.ZIndex="1" />
            <Grid Grid.Row="0" Background="{StaticResource Rail}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/hms-icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="HMS" FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="{StaticResource Accent}" Margin="10,1,0,0" VerticalAlignment="Center" />
                    <!-- the game: click to switch between the game folders the kit knows (NHL 27, NHL 24) -->
                    <Button x:Name="GameSwitch" Style="{StaticResource Ghost}" Margin="8,1,0,0" Padding="8,3" VerticalAlignment="Center" Click="OnGameSwitch"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Switch game">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GameBadge" Text="NHL 27  ·  PS5" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource Muted}" Margin="7,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="StatusChip" CornerRadius="999" Padding="10,3" Margin="0,0,14,0" VerticalAlignment="Center"
                            Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Patch}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusChipText" Text="Loading index" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ============================================================ body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- the ice: centre-ice circle, the red line and the two blue lines, faint under the pages -->
                <Grid Grid.Column="1" Background="{StaticResource Ice}" IsHitTestVisible="False">
                    <Viewbox Stretch="UniformToFill" Opacity="0.10">
                        <Canvas Width="2000" Height="850">
                            <Rectangle Canvas.Left="992" Width="16" Height="850" Fill="{StaticResource Goal}" />
                            <Rectangle Canvas.Left="660" Width="22" Height="850" Fill="{StaticResource Accent}" />
                            <Rectangle Canvas.Left="1318" Width="22" Height="850" Fill="{StaticResource Accent}" />
                            <Ellipse Canvas.Left="850" Canvas.Top="275" Width="300" Height="300" Stroke="{StaticResource Accent}" StrokeThickness="6" />
                            <Ellipse Canvas.Left="988" Canvas.Top="413" Width="24" Height="24" Fill="{StaticResource Accent}" />
                            <Ellipse Canvas.Left="250" Canvas.Top="110" Width="270" Height="270" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                            <Ellipse Canvas.Left="250" Canvas.Top="470" Width="270" Height="270" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                            <Ellipse Canvas.Left="1480" Canvas.Top="110" Width="270" Height="270" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                            <Ellipse Canvas.Left="1480" Canvas.Top="470" Width="270" Height="270" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                            <Ellipse Canvas.Left="370" Canvas.Top="230" Width="30" Height="30" Fill="{StaticResource Goal}" />
                            <Ellipse Canvas.Left="370" Canvas.Top="590" Width="30" Height="30" Fill="{StaticResource Goal}" />
                            <Ellipse Canvas.Left="1600" Canvas.Top="230" Width="30" Height="30" Fill="{StaticResource Goal}" />
                            <Ellipse Canvas.Left="1600" Canvas.Top="590" Width="30" Height="30" Fill="{StaticResource Goal}" />
                            <Rectangle Canvas.Left="90" Width="6" Height="850" Fill="{StaticResource Goal}" />
                            <Rectangle Canvas.Left="1904" Width="6" Height="850" Fill="{StaticResource Goal}" />
                            <Path Data="M 96,365 A 60,60 0 0 1 96,485 Z" Fill="{StaticResource Accent}" />
                            <Path Data="M 1904,365 A 60,60 0 0 0 1904,485 Z" Fill="{StaticResource Accent}" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- navigation rail -->
                <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,8,0,10">
                        <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Content="Settings" Tag="&#xE713;" Checked="OnNav" />
                        <!-- scrolls with the wheel when the window is too short for every page -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <RadioButton x:Name="NavPlay" Style="{StaticResource NavItem}" Content="Play" Tag="&#xE7FC;" Checked="OnNav" />
                            <RadioButton x:Name="NavExplorer" Style="{StaticResource NavItem}" Content="Explorer" Tag="&#xEC50;" IsChecked="True" Checked="OnNav" />
                            <RadioButton x:Name="NavTextures" Style="{StaticResource NavItem}" Content="Textures" Tag="&#xEB9F;" Checked="OnNav" />
                            <RadioButton x:Name="NavSounds" Style="{StaticResource NavItem}" Content="Sounds" Tag="&#xE767;" Checked="OnNav" />
                            <RadioButton x:Name="NavVideos" Style="{StaticResource NavItem}" Content="Videos" Tag="&#xE714;" Checked="OnNav" />
                            <RadioButton x:Name="NavRoster" Style="{StaticResource NavItem}" Content="Roster" Tag="&#xE716;" Checked="OnNav" />
                            <RadioButton x:Name="NavDatabase" Style="{StaticResource NavItem}" Content="Database" Tag="&#xE1D3;" Checked="OnNav" />
                            <RadioButton x:Name="NavTuning" Style="{StaticResource NavItem}" Content="Tuning" Tag="&#xE9E9;" Checked="OnNav" />
                            <RadioButton x:Name="NavTeams" Style="{StaticResource NavItem}" Content="Teams" Tag="&#xE790;" Checked="OnNav" />
                            <RadioButton x:Name="NavArenas" Style="{StaticResource NavItem}" Content="Arenas" Tag="&#xE80F;" Checked="OnNav" />
                            <RadioButton x:Name="NavBeAPro" Style="{StaticResource NavItem}" Content="Be A Pro" Tag="&#xE77B;" Checked="OnNav" />
                            <RadioButton x:Name="NavFranchise" Style="{StaticResource NavItem}" Content="Franchise" Tag="&#xE7C1;" Checked="OnNav" />
                            <RadioButton x:Name="NavUniforms" Style="{StaticResource NavItem}" Content="Uniforms" Tag="&#xE7BF;" Checked="OnNav" />
                            <RadioButton x:Name="NavStudio" Style="{StaticResource NavItem}" Content="Studio" Tag="&#xE790;" Checked="OnNav" />
                            <RadioButton x:Name="NavUnused" Style="{StaticResource NavItem}" Content="Unused" Tag="&#xE8F1;" ToolTip="Unused jerseys" Checked="OnNav" />
                            <RadioButton x:Name="NavScorebug" Style="{StaticResource NavItem}" Content="Scorebug" Tag="&#xE7F4;" Checked="OnNav" />
                            <RadioButton x:Name="ComingSoonArenas" Style="{StaticResource NavItem}" Content="Arenas" Tag="&#xE80F;" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Coming soon" />
                            <RadioButton x:Name="NavMods" Style="{StaticResource NavItem}" Content="Mods" Tag="&#xE74C;" Checked="OnNav" />
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ======================================================== explorer page -->
                <Grid x:Name="ExplorerPage" Grid.Column="1" Margin="22,18,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Click="OnOpenExports" ToolTip="Open the export folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Exports" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RebuildButton" Style="{StaticResource Ghost}" Click="OnRebuild" ToolTip="Read every TOC and bundle again" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Rebuild index" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Asset Explorer" Style="{StaticResource Title}" />
                            <TextBlock x:Name="Summary" Text="Reading the game's superbundles…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search 1.7M assets by path — e.g. jersey color, stadiums/detroit"
                                 TextChanged="OnSearchChanged" />
                        <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="9" Padding="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="KindEbx" Style="{StaticResource Segment}" GroupName="Kind" Content="EBX" IsChecked="True" Checked="OnKindChanged" />
                                <RadioButton x:Name="KindRes" Style="{StaticResource Segment}" GroupName="Kind" Content="RES" Checked="OnKindChanged" />
                                <RadioButton x:Name="KindChunk" Style="{StaticResource Segment}" GroupName="Kind" Content="Chunks" Checked="OnKindChanged" />
                            </StackPanel>
                        </Border>
                        <ComboBox x:Name="TypeFilter" Grid.Column="2" Margin="12,0,0,0" Height="40" SelectionChanged="OnTypeChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox x:Name="PatchedOnly" Grid.Column="3" Style="{StaticResource Switch}" Content="Patched only" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged" ToolTip="Only assets the 01.003 patch replaced" />
                    </Grid>

                    <!-- panes -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" MinWidth="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="380" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="400" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- folders -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,14,12,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,4" Click="OnCollapseAll" ToolTip="Collapse all">
                                        <TextBlock Text="&#xF165;" Style="{StaticResource Icon}" FontSize="12" />
                                    </Button>
                                    <TextBlock Text="FOLDERS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TreeView x:Name="Folders" Background="Transparent" BorderThickness="0" Padding="8,0,6,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          SelectedItemChanged="OnFolderSelected">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Foreground="{StaticResource Faint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Foreground="#E3B341" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </DockPanel>
                        </Border>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- assets -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                                    <TextBlock x:Name="ListCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ListTitle" Text="ALL ASSETS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <!-- column header -->
                                <Grid DockPanel.Dock="Top" Margin="10,0,18,4" TextElement.Foreground="{StaticResource Faint}" TextElement.FontSize="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Name" />
                                    <TextBlock Grid.Column="2" Text="Type" />
                                    <TextBlock Grid.Column="3" Text="Size" HorizontalAlignment="Right" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}" Margin="16,0,16,4" />
                                <Grid>
                                    <ListBox x:Name="Assets" Background="Transparent" BorderThickness="0" Padding="6,0,4,6"
                                             ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             SelectionChanged="OnAssetSelected" MouseDoubleClick="OnAssetDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:AssetRow}">
                                                <Grid Height="44" Margin="4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="78" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Tint}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Leaf}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                            <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,0" Background="{StaticResource PatchSoft}" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsPatched, Converter={StaticResource BoolVisible}}">
                                                                <TextBlock Text="PATCH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Patch}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TypeText}" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- empty / loading state -->
                                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                                            <TextBlock x:Name="EmptyGlyph" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent}" />
                                        </Border>
                                        <TextBlock x:Name="EmptyTitle" Text="Indexing NHL 27" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                        <TextBlock x:Name="EmptyText" Text="Reading 372k bundles across 203 CAS archives. The first run takes about a minute; after that it loads from cache."
                                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- details -->
                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <Grid>
                                <ScrollViewer x:Name="DetailsPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel Margin="20,18,20,20">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource Surface3}">
                                                <TextBlock x:Name="DetailGlyph" Style="{StaticResource Icon}" FontSize="20" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Pill}">
                                                    <TextBlock x:Name="DetailType" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                </Border>
                                                <TextBlock x:Name="DetailKind" Style="{StaticResource Caption}" Margin="2,5,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="DetailName" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,4" />
                                        <TextBlock x:Name="DetailPath" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="ExportButton" Style="{StaticResource Primary}" Click="OnExport">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                                                    <TextBlock x:Name="ExportLabel" Text="Export" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="8,0,0,0" Click="OnCopyPath" ToolTip="Copy the asset path">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                                                    <TextBlock Text="Copy path" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- sound preview (NewWaveAsset EBX) -->
                                        <StackPanel x:Name="SoundPreviewCard" Visibility="Collapsed">
                                            <DockPanel Margin="0,22,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" Click="OnOpenInSounds">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Open in Sounds" FontSize="12" />
                                                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="SoundPreviewTitle" Text="SOUND" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <local:SoundPlayerView x:Name="ExplorerPlayer" />
                                        </StackPanel>

                                        <!-- texture preview (TextureAsset EBX and Texture RES) -->
                                        <StackPanel x:Name="TexPreviewCard" Visibility="Collapsed">
                                            <DockPanel Margin="0,22,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" Click="OnOpenInTextures">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Open in Textures" FontSize="12" />
                                                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="TexPreviewTitle" Text="TEXTURE" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border CornerRadius="8" Background="{StaticResource Checker}" Height="260" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <Image x:Name="TexPreview" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock x:Name="TexPreviewNote" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="PROPERTIES" Style="{StaticResource Overline}" Margin="0,22,0,8" />
                                        <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14,6">
                                            <ItemsControl x:Name="DetailProps">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:Property}">
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{Binding Font}" FontSize="12" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <DockPanel Margin="0,22,0,8">
                                            <TextBlock x:Name="HexInfo" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock Text="DATA PREVIEW" Style="{StaticResource Overline}" Margin="0" />
                                        </DockPanel>
                                        <Border Background="#0A0C10" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <TextBlock x:Name="Hex" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDim}" LineHeight="17" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel x:Name="DetailsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                                    <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <TextBlock Text="Nothing selected" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                    <TextBlock Text="Pick an asset to see where it lives in the game data, preview its bytes and export it."
                                               Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ======================================================== mods page -->
                <local:ModsPage x:Name="ModsPage" Grid.Column="1" Visibility="Collapsed" />

                <local:RosterPage x:Name="RosterPage" Grid.Column="1" Visibility="Collapsed" />

                <local:UniformsPage x:Name="UniformsPage" Grid.Column="1" Visibility="Collapsed" />
                <local:JerseyStudioPage x:Name="StudioPage" Grid.Column="1" Visibility="Collapsed" />
                <local:UnusedPage x:Name="UnusedPage" Grid.Column="1" Visibility="Collapsed" />
                <local:ScorebugPage x:Name="ScorebugPage" Grid.Column="1" Visibility="Collapsed" />
                <local:Scorebug24Page x:Name="Scorebug24Page" Grid.Column="1" Visibility="Collapsed" />
                <local:DatabasePage x:Name="DatabasePage" Grid.Column="1" Visibility="Collapsed" />
                <local:TuningPage x:Name="TuningPage" Grid.Column="1" Visibility="Collapsed" />
                <local:TeamsPage x:Name="TeamsPage" Grid.Column="1" Visibility="Collapsed" />
                <local:BeAProPage x:Name="BeAProPage" Grid.Column="1" Visibility="Collapsed" />
                <local:FranchisePage x:Name="FranchisePage" Grid.Column="1" Visibility="Collapsed" />
                <local:ArenasPage x:Name="ArenasPage" Grid.Column="1" Visibility="Collapsed" />

                <!-- ======================================================== sounds page -->
                <local:SoundPage x:Name="SoundPage" Grid.Column="1" Visibility="Collapsed" />

                <!-- ======================================================== videos page -->
                <local:VideoPage x:Name="VideoPage" Grid.Column="1" Visibility="Collapsed" />

                <!-- ======================================================== textures page -->
                <local:TexturePage x:Name="TexturePage" Grid.Column="1" Visibility="Collapsed" />

                <!-- ======================================================== play page -->
                <local:PlayPage x:Name="PlayPage" Grid.Column="1" Visibility="Collapsed" />
                <local:Play24Page x:Name="Play24Page" Grid.Column="1" Visibility="Collapsed" />

                <!-- ======================================================== settings page -->
                <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,14" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource Title}" />
                        <TextBlock Text="Where the kit finds the game and keeps its files." Style="{StaticResource Caption}" Margin="0,3,0,18" />

                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="GAME FOLDER" Style="{StaticResource Overline}" />
                                <TextBlock Text="The extracted game: NHL 27 (PS5) or NHL 24 (PS4), the folder with eboot.bin and Data. Each game keeps its own index and mod list."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Switch game" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="GamePicker" DisplayMemberPath="Label" SelectionChanged="OnGamePicked" />
                                </DockPanel>
                                <CheckBox x:Name="AskGame" Style="{StaticResource Switch}" Content="Ask which game to open at startup" Margin="0,0,0,12"
                                          Checked="OnAskGame" Unchecked="OnAskGame" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Height="36" Click="OnBrowseGame" />
                                    <TextBox x:Name="GameDir" Tag="C:\…\NHL 27 dump\NHL" LostFocus="OnGameDirChanged" />
                                </DockPanel>
                                <TextBlock x:Name="GameCheck" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="GAME" Style="{StaticResource Overline}" />
                                <ItemsControl x:Name="GameProps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Property}">
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{Binding Font}" FontSize="12.5" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="KIT" Style="{StaticResource Overline}" />
                                <ItemsControl x:Name="KitProps" ItemTemplate="{Binding ItemTemplate, ElementName=GameProps}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Rebuild index" Click="OnRebuild" />
                                    <Button Content="Open kit folder" Margin="8,0,0,0" Click="OnOpenKit" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============================================================ status bar -->
            <Border Grid.Row="2" Background="#06090F" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" TextElement.FontFamily="{StaticResource BoardFont}">
                <Grid>
                    <ProgressBar x:Name="Progress" VerticalAlignment="Top" IsIndeterminate="True" Margin="0,-1,0,0" />
                    <DockPanel Margin="14,0" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Right" Text="MADE BY SONKU" FontFamily="{StaticResource DisplayFont}" FontSize="12" Foreground="{StaticResource Accent}" Margin="16,0,0,0" />
                        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11.5" />
                        <TextBlock x:Name="Status" Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>
            <!-- ============================================================ startup screen: over everything until the index is read -->
            <Grid x:Name="Splash" Grid.RowSpan="3" Panel.ZIndex="100" Background="{StaticResource Ice}" ClipToBounds="True">
                <!-- the rink -->
                <Viewbox Stretch="UniformToFill" Opacity="0.16" IsHitTestVisible="False">
                    <Canvas Width="2000" Height="900">
                        <Rectangle Canvas.Left="992" Width="16" Height="900" Fill="{StaticResource Goal}" />
                        <Rectangle Canvas.Left="640" Width="24" Height="900" Fill="{StaticResource Accent}" />
                        <Rectangle Canvas.Left="1336" Width="24" Height="900" Fill="{StaticResource Accent}" />
                        <Ellipse Canvas.Left="820" Canvas.Top="270" Width="360" Height="360" Stroke="{StaticResource Accent}" StrokeThickness="7" />
                        <Ellipse Canvas.Left="230" Canvas.Top="110" Width="280" Height="280" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                        <Ellipse Canvas.Left="230" Canvas.Top="510" Width="280" Height="280" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                        <Ellipse Canvas.Left="1490" Canvas.Top="110" Width="280" Height="280" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                        <Ellipse Canvas.Left="1490" Canvas.Top="510" Width="280" Height="280" Stroke="{StaticResource Goal}" StrokeThickness="5" />
                    </Canvas>
                </Viewbox>
                <!-- the arena lights falling on centre ice -->
                <Ellipse Width="900" Height="520" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#203B8BFF" Offset="0" />
                            <GradientStop Color="#003B8BFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                    <!-- the HMS badge, breathing gently -->
                    <Image x:Name="SplashBadge" Source="Assets/hms-badge.png" Width="176" Height="176" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.35" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="HMS" FontFamily="{StaticResource DisplayFont}" FontSize="54" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <Rectangle Height="4" Width="320" Margin="0,4,0,0" Fill="{StaticResource RinkStripe}" />
                    <TextBlock Text="HOCKEY MODDING SUITE" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="{StaticResource Text}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock x:Name="SplashGame" Text="NHL 27  ·  PS5" FontFamily="{StaticResource BoardFont}" FontSize="14"
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />

                    <!-- picking the game (when the kit knows more than one): a card per game, its cover from sce_sys -->
                    <StackPanel x:Name="GamePick" Visibility="Collapsed" Margin="0,28,0,0">
                        <TextBlock Text="PICK YOUR GAME" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,18" />
                        <ItemsControl x:Name="GameCards" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnGameCard" Margin="10,0" Cursor="Hand" ToolTip="{Binding Dir}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Width="236" Padding="14" CornerRadius="16" BorderThickness="1.5"
                                                        Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}">
                                                    <StackPanel>
                                                        <Grid Width="206" Height="206">
                                                            <Border CornerRadius="10" Background="{StaticResource Surface2}" />
                                                            <TextBlock Text="{Binding Short}" FontFamily="{StaticResource DisplayFont}" FontSize="64" Foreground="{StaticResource Faint}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border CornerRadius="10">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                        <DockPanel Margin="2,14,2,0">
                                                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Platform}" FontSize="11" Foreground="{StaticResource Accent}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource Text}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource BoardFont}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="2,2,2,0" />
                                                        <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource Faint}" Margin="2,6,2,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Goal}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Style="{StaticResource Ghost}" Content="Another game folder…" Click="OnPickBrowse" Margin="0,0,18,0" />
                            <CheckBox x:Name="PickRemember" Style="{StaticResource Switch}" Content="Don't ask again" VerticalAlignment="Center"
                                      ToolTip="Open this game straight away next time. Switch games from the title bar, or turn this back on in Settings." />
                        </StackPanel>
                    </StackPanel>

                    <!-- loading: a puck sliding along the line -->
                    <StackPanel x:Name="SplashLoading">
                    <Grid Width="320" Height="14" Margin="0,46,0,0" ClipToBounds="True">
                        <Rectangle Height="2" VerticalAlignment="Center" Fill="#22FFFFFF" RadiusX="1" RadiusY="1" />
                        <Canvas>
                            <Ellipse x:Name="SplashSlide" Width="12" Height="12" Canvas.Top="1" Fill="{StaticResource Goal}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource GoalColor}" BlurRadius="14" ShadowDepth="0" Opacity="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="SplashStatus" Text="{Binding Text, ElementName=Status}" FontFamily="{StaticResource BoardFont}" FontSize="12.5"
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="560" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="MADE BY SONKU" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" />
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SplashBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1" To="1.04" Duration="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SplashBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="1.04" Duration="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SplashSlide" Storyboard.TargetProperty="(Canvas.Left)"
                                                 From="-12" To="320" Duration="0:0:1.3" RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>
        </Grid>
    </Border>
</Window>
