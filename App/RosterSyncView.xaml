<UserControl x:Class="NHL27Kit.App.RosterSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- sources, fetch, filters -->
        <StackPanel>
        <!-- stage 1: a shared roster as the game's base roster (RosterBaseline) -->
        <Border x:Name="BaselineCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BaselinePick" Padding="12,6" Click="OnBaselinePick" ToolTip="Pick a RosterCustom save folder (a shared roster)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Choose roster…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BaselinePreview" Padding="12,6" Margin="8,0,0,0" Click="OnBaselinePreview" IsEnabled="False" ToolTip="Show what using this roster would change. Nothing is written.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Preview" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BaselineApply" Style="{StaticResource Primary}" Padding="12,6" Margin="8,0,0,0" Click="OnBaselineApply" IsEnabled="False"
                                ToolTip="Copy this roster over the game's base roster and make its Create-a-Player players real players">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Use as base roster" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="999" Padding="7,1" Background="{StaticResource Surface2}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="STEP 1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Base roster" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="BaselineState" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Recommended: start from a shared roster (a RosterCustom save) with its ratings, gear and created prospects. Its tables replace the game's roster, and its Create-a-Player players become real players, so they show up in franchise. NHL Sync (step 2) then brings it up to date." />
                        <TextBlock x:Name="BaselinePath" Style="{StaticResource Caption}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <!-- what step 1 is doing while it reads, previews or writes -->
                <StackPanel x:Name="BaselineProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock x:Name="BaselinePercent" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="10,0,0,0" />
                        <TextBlock x:Name="BaselineProgressText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar x:Name="BaselineProgress" Height="6" Margin="0,5,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" />
                </StackPanel>
                <TextBox x:Name="BaselineDetails" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MaxHeight="190" Margin="0,10,0,0" FontFamily="Consolas" FontSize="11.5" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="FetchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="14,7" VerticalAlignment="Top" Click="OnFetch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock x:Name="FetchLabel" Text="Fetch &amp; compare" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="999" Padding="7,1" Background="{StaticResource Surface2}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="STEP 2" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </Border>
                            <TextBlock Text="Sync with the NHL" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="The ticked sources are read at the same time. Rosters are compared first and the new players' bios looked up; contracts, picks and lines are checked last, against the rosters as Apply will leave them. Nothing in the game changes until you press Apply." />
                    </StackPanel>
                </DockPanel>

                <!-- one card per source: where the data comes from, what it gives the game, and each step's progress -->
                <ItemsControl x:Name="SourceList" Margin="0,12,-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SyncSource}">
                            <Border x:Name="Card" CornerRadius="8" Padding="12,10,12,9" Margin="0,0,10,0" BorderThickness="1"
                                    Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" ToolTip="{Binding Tip}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="Box" DockPanel.Dock="Left" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Read this source" />
                                        <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="999" Padding="7,1" VerticalAlignment="Center"
                                                Background="{StaticResource Surface3}" Visibility="{Binding StateText, Converter={StaticResource NonEmptyVisible}}">
                                            <TextBlock x:Name="BadgeText" Text="{Binding StateText}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Host}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Provides}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8" MinHeight="30" />
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,6" />
                                    <ItemsControl x:Name="Steps" ItemsSource="{Binding Steps}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:SyncStage}">
                                                <DockPanel Margin="0,2" ToolTip="{Binding Detail}">
                                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource Faint}" StrokeThickness="1.5" />
                                                    <TextBlock x:Name="Label" DockPanel.Dock="Left" Text="{Binding Label}" Margin="7,0,10,0" FontSize="12" Foreground="{StaticResource TextDim}" />
                                                    <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Waiting">
                                                        <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Good}" />
                                                        <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Good}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Danger}" />
                                                        <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Optional}" Value="False">
                                    <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOn}" Value="False">
                                    <Setter TargetName="Steps" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Running">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Good}" />
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource GoodSoft}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Good}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Danger}" />
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoft}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="FetchStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Press Fetch &amp; compare to read the ticked sources." />

                <StackPanel x:Name="FilterBar" Margin="0,12,0,0" IsEnabled="True">
                    <DockPanel>
                        <TextBox x:Name="SyncSearch" DockPanel.Dock="Right" Width="220" Style="{StaticResource SearchBox}" Tag="Name or team" TextChanged="OnFilter" />
                        <CheckBox x:Name="SizesBox" DockPanel.Dock="Right" Content="Sync heights &amp; weights" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="True" Checked="OnSizes" Unchecked="OnSizes" Foreground="{StaticResource TextDim}" />
                        <Border CornerRadius="9" Padding="3" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="KindReview" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Review" IsChecked="True" Checked="OnFilter"
                                             ToolTip="Only the changes that need you: everything else is applied automatically" />
                                <RadioButton x:Name="KindAll" Style="{StaticResource Segment}" GroupName="SyncKind" Content="All" Checked="OnFilter" />
                                <RadioButton x:Name="KindMove" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Trades" Checked="OnFilter" />
                                <RadioButton x:Name="KindJoin" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Call-ups" Checked="OnFilter" />
                                <RadioButton x:Name="KindUpdate" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Info" Checked="OnFilter" />
                                <RadioButton x:Name="KindLeft" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Left NHL" Checked="OnFilter" />
                                <RadioButton x:Name="KindMissing" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Not in game" Checked="OnFilter" />
                                <RadioButton x:Name="KindContracts" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Contracts" Checked="OnFilter" />
                                <RadioButton x:Name="KindPositions" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Positions" Checked="OnFilter" />
                                <RadioButton x:Name="KindPicks" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Picks" Checked="OnFilter" />
                                <RadioButton x:Name="KindLines" Style="{StaticResource Segment}" GroupName="SyncKind" Content="Lines" Checked="OnFilter" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- changes -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TickAll" Content="Tick shown" Padding="10,6" Click="OnTickAll" IsEnabled="False" />
                        <Button x:Name="TickNone" Content="Untick shown" Padding="10,6" Margin="8,0,0,0" Click="OnTickNone" IsEnabled="False" />
                        <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Padding="14,6" Margin="8,0,0,0" Click="OnApply" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock x:Name="ApplyLabel" Text="Apply to game" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ApplyStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="ChangeList" Background="Transparent" BorderThickness="0" Padding="6,8,4,4" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SyncRow}">
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanApply}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding KindBrush}">
                                        <TextBlock Text="{Binding KindText}" Foreground="#E6000000" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Patch}"
                                                   Visibility="{Binding Note, Converter={StaticResource NonEmptyVisible}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="Press Fetch &amp; compare to compare the game with today's NHL and AHL." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
