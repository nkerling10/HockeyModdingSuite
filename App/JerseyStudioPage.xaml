<UserControl x:Class="NHL27Kit.App.JerseyStudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- a team colour: clicking it fills the selected colour box -->
        <DataTemplate x:Key="SwatchTemplate">
            <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" Click="OnSwatch" Tag="{Binding Hex}" ToolTip="{Binding Hex}" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{Binding Brush}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <!-- a design in a picker: a thumbnail with a border when hovered or picked -->
        <Style x:Key="PickItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="2" Padding="2" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PartThumb" DataType="{x:Type local:StudioTemplateRow}">
            <Grid Width="44" Height="44" ToolTip="{Binding Label}">
                <Border CornerRadius="6" Background="{StaticResource Surface3}" ClipToBounds="True">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2" Padding="3,0" CornerRadius="3" Background="#B0101318">
                    <TextBlock Text="{Binding Short}" FontSize="9" Foreground="White" />
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="OwnRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>
        <Style x:Key="Hex" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterCasing" Value="Upper" />
        </Style>

        <!-- the studio's tabs: an icon over a label -->
        <Style x:Key="StudioTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="2,7,2,6" Background="Transparent">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <DataTemplate x:Key="ZoneTemplate" DataType="{x:Type local:StudioZone}">
                <Border x:Name="Bd" Margin="0,0,0,5" Padding="8,5" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" MouseLeftButtonDown="OnStudioZoneClick" Cursor="Hand">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="5" Margin="0,0,9,0" Background="{Binding Swatch}"
                                BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Hex}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="OnStudioZoneFocus" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="12" />
                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="10.5" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <TextBox x:Name="Search" DockPanel.Dock="Right" Width="300" Style="{StaticResource SearchBox}" Tag="Search teams — e.g. toronto, chl, sweden"
                     TextChanged="OnSearchChanged" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Jersey Studio" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- your own uniform, or the kit a design starts from -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Margin="12,12,12,6" Background="{StaticResource Surface2}" CornerRadius="8" Padding="3">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ModeOwn" Style="{StaticResource Segment}" GroupName="StudioMode" Content="Your own" IsChecked="True" Checked="OnMode"
                                         ToolTip="A uniform of your own from the game's create-a-team parts: no team's art or logos" />
                            <RadioButton x:Name="ModeTeam" Style="{StaticResource Segment}" GroupName="StudioMode" Content="From a team" Checked="OnMode"
                                         ToolTip="Start from a team's kit as it is in the game" />
                        </UniformGrid>
                    </Border>
                    <Grid>
                        <ScrollViewer x:Name="OwnPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,4,10,12">
                                <TextBlock Text="YOUR COLOURS" Style="{StaticResource SectionHead}" />
                                <DockPanel Style="{StaticResource OwnRow}">
                                    <Border x:Name="OwnColor0Swatch" Width="22" Height="22" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
                                    <TextBox x:Name="OwnColor0" DockPanel.Dock="Right" Style="{StaticResource Hex}" Tag="0" TextChanged="OnOwnColor" GotKeyboardFocus="OnOwnColorFocus" />
                                    <TextBlock Text="Main" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="The body of the jersey, the pants and the helmet" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource OwnRow}">
                                    <Border x:Name="OwnColor1Swatch" Width="22" Height="22" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
                                    <TextBox x:Name="OwnColor1" DockPanel.Dock="Right" Style="{StaticResource Hex}" Tag="1" TextChanged="OnOwnColor" GotKeyboardFocus="OnOwnColorFocus" />
                                    <TextBlock Text="Second" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource OwnRow}">
                                    <Border x:Name="OwnColor2Swatch" Width="22" Height="22" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
                                    <TextBox x:Name="OwnColor2" DockPanel.Dock="Right" Style="{StaticResource Hex}" Tag="2" TextChanged="OnOwnColor" GotKeyboardFocus="OnOwnColorFocus" />
                                    <TextBlock Text="Third" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="The design, pants, socks, helmet and gloves are dealt these colours. Every zone can still be changed on the right." />

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Swap" Padding="6,2" Click="OnLetterSwap" ToolTip="Swap the fill and outline colours" />
                                    <TextBlock Text="LETTERING" Style="{StaticResource SectionHead}" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource OwnRow}">
                                    <Border x:Name="LetterFillSwatch" Width="22" Height="22" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
                                    <TextBox x:Name="LetterFill" DockPanel.Dock="Right" Style="{StaticResource Hex}" Tag="fill" TextChanged="OnLetterColor" GotKeyboardFocus="OnOwnColorFocus" />
                                    <TextBlock Text="Fill" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource OwnRow}">
                                    <Border x:Name="LetterOutlineSwatch" Width="22" Height="22" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
                                    <TextBox x:Name="LetterOutline" DockPanel.Dock="Right" Style="{StaticResource Hex}" Tag="outline" TextChanged="OnLetterColor" GotKeyboardFocus="OnOwnColorFocus" />
                                    <TextBlock Text="Outline" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox x:Name="OwnFonts" Height="150" Background="{StaticResource Surface2}" BorderThickness="0" Padding="3" Margin="0,2,0,10"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PickItem}" SelectionChanged="OnOwnPart">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:StudioTemplateRow}">
                                            <Border Width="94" Height="32" CornerRadius="6" Background="{StaticResource Surface3}" ClipToBounds="True" ToolTip="{Binding Label}">
                                                <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Shuffle" Padding="6,2" Click="OnPantShuffle" ToolTip="Move the colours round the pants' zones" />
                                    <TextBlock Text="PANTS" Style="{StaticResource SectionHead}" />
                                </DockPanel>
                                <ListBox x:Name="OwnPants" Height="104" Background="{StaticResource Surface2}" BorderThickness="0" Padding="3" Margin="0,0,0,10"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PickItem}" ItemTemplate="{StaticResource PartThumb}"
                                         SelectionChanged="OnOwnPart">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Shuffle" Padding="6,2" Click="OnSockShuffle" ToolTip="Move the colours round the socks' zones" />
                                    <TextBlock Text="SOCKS" Style="{StaticResource SectionHead}" />
                                </DockPanel>
                                <ListBox x:Name="OwnSocks" Height="104" Background="{StaticResource Surface2}" BorderThickness="0" Padding="3" Margin="0,0,0,10"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PickItem}" ItemTemplate="{StaticResource PartThumb}"
                                         SelectionChanged="OnOwnPart">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"
                                           Text="In game the helmet and gloves take the team's equipment colours: set them on Uniforms, Helmet &amp; gloves." />
                            </StackPanel>
                        </ScrollViewer>

                        <DockPanel x:Name="TeamPanel" Visibility="Collapsed">
                            <DockPanel DockPanel.Dock="Top" Margin="16,8,16,8">
                                <TextBlock x:Name="TeamCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="START FROM" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="TeamList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnTeamSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TeamRow}">
                                        <StackPanel Margin="6,7">
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- the design on the game's models -->
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.7">
                        <GradientStop Color="#2A3240" Offset="0" />
                        <GradientStop Color="#14181F" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Grid>
                    <local:KitViewer x:Name="Viewer" Margin="0,64,0,52" />
                    <DockPanel VerticalAlignment="Top" Margin="18,14,18,0">
                        <ComboBox x:Name="KitPicker" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" SelectionChanged="OnKitPicked" DisplayMemberPath="Label"
                                  ToolTip="The kit the design starts from: its jersey, stamp, logos and lettering" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TeamTitle" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock x:Name="KitTitle" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel VerticalAlignment="Bottom" Margin="18,0,18,14">
                        <Border DockPanel.Dock="Right" Background="#B0101318" CornerRadius="9" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Ghost}" Content="Front" Padding="10,4" Click="OnFront" />
                                <Button Style="{StaticResource Ghost}" Content="Side" Padding="10,4" Click="OnSide" />
                                <Button Style="{StaticResource Ghost}" Content="Back" Padding="10,4" Click="OnBack" />
                                <Button Style="{StaticResource Ghost}" Content="Collar" Padding="10,4" Tag="front" Click="OnCollarView" ToolTip="The collar up close" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Drag to turn  ·  scroll to zoom  ·  double-click to reset">
                            <TextBlock Text="Name" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="LetterName" Width="120" MaxLength="16" CharacterCasing="Upper" TextChanged="OnLetteringChanged" />
                            <TextBlock Text="No." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox x:Name="LetterNumber" Width="46" MaxLength="2" TextChanged="OnLetteringChanged" />
                            <ComboBox x:Name="LetterCaptain" Width="64" Margin="10,0,0,0" SelectionChanged="OnLetteringChanged" ToolTip="Captain's letter">
                                <ComboBoxItem Content="—" />
                                <ComboBoxItem Content="C" />
                                <ComboBoxItem Content="A" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="ViewBusy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="ViewBusyText" Text="Loading the kit from the game…" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ViewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a team to start from" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Its jersey opens here on the game's models. Design over it, add lines and logos, then write it over the kit or add it to any team's jersey menu."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- the design: one tab at a time, the team colours always at hand, the actions at the bottom -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,0">
                        <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="3">
                            <UniformGrid Columns="6">
                                <RadioButton Style="{StaticResource StudioTab}" GroupName="StudioTab" Uid="design" Tag="&#xE771;" Content="Design" IsChecked="True" Checked="OnStudioTab" />
                                <RadioButton Style="{StaticResource StudioTab}" GroupName="StudioTab" Uid="colours" Tag="&#xE790;" Content="Colours" Checked="OnStudioTab" />
                                <RadioButton Style="{StaticResource StudioTab}" GroupName="StudioTab" Uid="collar" Tag="&#xE8EC;" Content="Collar" Checked="OnStudioTab" />
                                <RadioButton Style="{StaticResource StudioTab}" GroupName="StudioTab" Uid="lines" Tag="&#xE8FD;" Content="Lines" Checked="OnStudioTab" />
                                <RadioButton Style="{StaticResource StudioTab}" GroupName="StudioTab" Uid="logos" Tag="&#xE8B9;" Content="Logos" Checked="OnStudioTab" />
                                <RadioButton Style="{StaticResource StudioTab}" GroupName="StudioTab" Uid="menu" Tag="&#xE8A9;" Content="Team menu" Checked="OnStudioTab" />
                            </UniformGrid>
                        </Border>
                        <Border Margin="0,10,0,0" Padding="10,4,10,0" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" Click="OnStudioShuffle" ToolTip="Deal the team colours to the zones in another order">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B1;" Style="{StaticResource Icon}" FontSize="11" />
                                            <TextBlock Text="Shuffle" Margin="5,0,0,0" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="TEAM COLOURS  ·  click a box, then a swatch" Style="{StaticResource SectionHead}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl x:Name="StudioTeamColors" Margin="0,0,0,4" ItemTemplate="{StaticResource SwatchTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,14">
                        <TextBlock x:Name="StudioStatus" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button x:Name="StudioWrite" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,7" Click="OnStudioWrite" IsEnabled="False" VerticalAlignment="Bottom"
                                    ToolTip="Writes the jersey (base and baked textures), replaced logos and moved hotspots over this kit in the game. Restore on the Mods page undoes it.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Write over this kit" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Style="{StaticResource Ghost}" Content="Open…" Padding="7,5" Click="OnStudioOpen" ToolTip="Open a saved design (.jersey.json)" />
                                <Button Style="{StaticResource Ghost}" Content="Save…" Padding="7,5" Click="OnStudioSaveDesign" ToolTip="Save this design to use on another kit" />
                                <Button Style="{StaticResource Ghost}" Content="PNG…" Padding="7,5" Click="OnStudioExport" ToolTip="Export the designed jersey texture" />
                                <Button Style="{StaticResource Ghost}" Content="Guide…" Padding="7,5" Click="OnStudioTemplate"
                                        ToolTip="Save a guide to the jersey texture (DDS or PNG): each part in its own colour, the logo and lettering spots, lines every 10 cm. Paint over it, then bring it back with Use an image." />
                                <Button x:Name="StudioReset" Style="{StaticResource Ghost}" Content="Reset" Padding="7,5" Click="OnStudioReset" ToolTip="Back to the kit as it is in the game" />
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="StudioScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,12,0">
                        <Grid>
                        <StackPanel x:Name="TabDesign">
                            <TextBlock Text="Design" Style="{StaticResource TabTitle}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="What's painted under everything: the kit's own art, one of the game's create-a-team designs in your colours, a whole texture of your own, or a photo of a real jersey." />
                            <TextBlock x:Name="StudioInfo" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DockPanel>
                                <TextBlock x:Name="StudioTemplateCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="THE GAME'S CREATE-A-TEAM JERSEYS" Style="{StaticResource SectionHead}" />
                            </DockPanel>
                            <ListBox x:Name="StudioTemplates" Height="300" ItemContainerStyle="{StaticResource PickItem}" Background="{StaticResource Surface2}" BorderThickness="0" Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnStudioTemplate">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:StudioTemplateRow}">
                                        <Grid Width="58" Height="58" ToolTip="{Binding Label}">
                                            <Border CornerRadius="6" Background="{StaticResource Surface3}" ClipToBounds="True">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2" Padding="3,0" CornerRadius="3" Background="#B0101318">
                                                <TextBlock Text="{Binding Short}" FontSize="9.5" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="OR START FROM" Style="{StaticResource SectionHead}" Margin="0,14,0,6" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource Ghost}" Content="Use an image…" Padding="8,4" Click="OnStudioImage"
                                        ToolTip="A whole jersey texture (PNG or DDS) in the NHL 27 layout as the art under the design (hold Shift for a legacy one: it's converted)" />
                                <Button Style="{StaticResource Ghost}" Content="From a photo…" Padding="8,4" Margin="6,0,0,0" Click="OnStudioPhoto"
                                        ToolTip="Mark the stripes and crest on a photo of a real jersey: its colours and stripes become this jersey's color map, with the crest painted in and the maker's, NHL and sponsor logos left off" />
                                <Button x:Name="StudioClearImage" Style="{StaticResource Ghost}" Content="Clear image" Padding="8,4" Click="OnStudioClearImage" Visibility="Collapsed" />
                            </WrapPanel>

                        </StackPanel>
                        <StackPanel x:Name="TabColours" Visibility="Collapsed">
                            <TextBlock Text="Colours" Style="{StaticResource TabTitle}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="Flat fills of the jersey's fabric. A design's own colours come first, then the body, shoulders, sides and gussets. Blank keeps the art." />
                            <ItemsControl x:Name="StudioZones" Margin="0,0,0,10" ItemTemplate="{StaticResource ZoneTemplate}" />

                        </StackPanel>
                        <StackPanel x:Name="TabCollar" Visibility="Collapsed">
                            <TextBlock Text="Collar" Style="{StaticResource TabTitle}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="Every piece of the collar in a colour of its own, and stripes round the neck band: piping, two-tone, as many as you like." />
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Ghost}" Padding="8,3" Content="Front" FontSize="11.5" Tag="front" Click="OnCollarView" ToolTip="Look at the collar from the front, up close" />
                                    <Button Style="{StaticResource Ghost}" Padding="8,3" Content="Back" FontSize="11.5" Tag="back" Click="OnCollarView" ToolTip="Look at the collar from the back, up close" />
                                </StackPanel>
                                <TextBlock Text="PIECES  ·  blank keeps the art" Style="{StaticResource SectionHead}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="CollarZones" Margin="0,0,0,10" ItemTemplate="{StaticResource ZoneTemplate}" />

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" Click="OnAddCollarStripe" ToolTip="A stripe across the neck band">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" />
                                        <TextBlock Text="Stripe" Margin="5,0,0,0" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="COLLAR STRIPES" Style="{StaticResource SectionHead}" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource Ghost}" Padding="8,3" Margin="0,0,4,4" FontSize="11.5" Content="Piping" Tag="piping" Click="OnCollarPreset" ToolTip="A thin stripe along the edge at the neck" />
                                <Button Style="{StaticResource Ghost}" Padding="8,3" Margin="0,0,4,4" FontSize="11.5" Content="Two-tone" Tag="twotone" Click="OnCollarPreset" ToolTip="The half by the neck in the second colour" />
                                <Button Style="{StaticResource Ghost}" Padding="8,3" Margin="0,0,4,4" FontSize="11.5" Content="Three stripes" Tag="triple" Click="OnCollarPreset" />
                                <Button Style="{StaticResource Ghost}" Padding="8,3" Margin="0,0,4,4" FontSize="11.5" Content="Edges" Tag="edges" Click="OnCollarPreset" ToolTip="Trim along both edges" />
                                <Button Style="{StaticResource Ghost}" Padding="8,3" Margin="0,0,4,4" FontSize="11.5" Content="Plain" Tag="plain" Click="OnCollarPreset" ToolTip="No stripes" />
                            </WrapPanel>
                            <TextBlock x:Name="CollarStripesEmpty" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="No stripes. Each one runs along the collar's front and round the neck band, measured from the edge sewn to the jersey (0%) to the edge at the neck (100%)." />
                            <ItemsControl x:Name="CollarStripeList" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CollarStripeRow}">
                                        <Border x:Name="Bd" Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="% of the way up the band, from the seam" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding From}" Margin="0,3" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FromText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding Width}" Margin="0,3" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WidthText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <DockPanel Margin="0,4,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="5,3" Click="OnRemoveCollarStripe" ToolTip="Remove this stripe">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                    <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,6,0" Background="{Binding Swatch}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                                    <TextBox Style="{StaticResource Hex}" HorizontalAlignment="Left" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="OnCollarStripeFocus" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel x:Name="TabLines" Visibility="Collapsed">
                            <TextBlock Text="Lines" Style="{StaticResource TabTitle}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="Stripes round the body (from the hem) and both sleeves (from the cuff), measured on the model so both sides match. A line can be a flat colour with an edge, or an image of your own wrapped round." />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Ghost}" Padding="6,2" Click="OnLinesPng" Content="PNG…" FontSize="11.5"
                                            ToolTip="Save the lines on their own: a see-through sheet in the jersey texture's layout" />
                                    <Button Style="{StaticResource Ghost}" Padding="6,2" Click="OnAddBodyLine" ToolTip="A stripe round the body, measured up from the hem">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" />
                                            <TextBlock Text="Body" Margin="5,0,0,0" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" Padding="6,2" Click="OnAddSleeveLine" ToolTip="A stripe round both sleeves, measured from the cuff">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" />
                                            <TextBlock Text="Sleeves" Margin="5,0,0,0" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="ADD A LINE" Style="{StaticResource SectionHead}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="LinesEmpty" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="No lines yet. Add one round the body or the sleeves: it wraps round the model, seams and all, and sits under the logos." />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="A line can be an image of your own wrapped round (Image…): save a Template… for its size, paint on it, load it back. Ctrl+drag on the jersey moves the selected line there." />
                            <ItemsControl x:Name="LineList" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LineRow}">
                                        <Border x:Name="Bd" Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="OnLineRowDown">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="5,3" Click="OnRemoveLine" ToolTip="Remove this line">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="5,3" Click="OnCopyLine" ToolTip="Another line like this one, just past it">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" />
                                                    </Button>
                                                    <ComboBox Width="96" Height="26" Padding="6,2" FontSize="11.5" SelectedIndex="{Binding PlaceIndex}" HorizontalAlignment="Left">
                                                        <ComboBoxItem Content="Body" />
                                                        <ComboBoxItem Content="Sleeves" />
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </DockPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="cm from the hem (body) or the cuff (sleeves)" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding FromMax}" SmallChange="0.5" LargeChange="2" Value="{Binding From}" Margin="0,3" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FromText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="Width" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="25" SmallChange="0.5" LargeChange="2" Value="{Binding Width}" Margin="0,3" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WidthText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Text="Edge" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="A trim of another colour on both sides"
                                                               Visibility="{Binding NoImage, Converter={StaticResource BoolVisible}}" />
                                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="5" SmallChange="0.25" LargeChange="1" Value="{Binding EdgeWidth}" Margin="0,3"
                                                            Visibility="{Binding NoImage, Converter={StaticResource BoolVisible}}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding EdgeText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Visibility="{Binding NoImage, Converter={StaticResource BoolVisible}}" />
                                                    <TextBlock Grid.Row="2" Text="Repeat" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="How many times the image goes round"
                                                               Visibility="{Binding HasImage, Converter={StaticResource BoolVisible}}" />
                                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="24" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Repeat}" Margin="0,3"
                                                            Visibility="{Binding HasImage, Converter={StaticResource BoolVisible}}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RepeatText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Visibility="{Binding HasImage, Converter={StaticResource BoolVisible}}" />
                                                </Grid>
                                                <DockPanel Margin="0,4,0,0" Visibility="{Binding HasImage, Converter={StaticResource BoolVisible}}">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="5,3" Click="OnLineClearImage" ToolTip="Back to a flat colour">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" />
                                                    </Button>
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Both sides alike" IsChecked="{Binding Mirror}" Margin="8,0,4,0" VerticalAlignment="Center"
                                                              ToolTip="On: the image runs from the front centre to the back centre and the other side is its mirror. Off: it goes once round, the front centre in its middle." />
                                                    <Border Background="{StaticResource Checker}" CornerRadius="4" Height="26" HorizontalAlignment="Left" MaxWidth="150">
                                                        <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                    </Border>
                                                </DockPanel>
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button Style="{StaticResource Ghost}" Padding="6,2" Margin="0,0,4,4" Content="Image…" FontSize="11.5" Click="OnLineImage"
                                                            ToolTip="Wrap an image of your own round as this line (PNG or DDS). Its height is the line's width." />
                                                    <Button Style="{StaticResource Ghost}" Padding="6,2" Margin="0,0,10,4" Content="Template…" FontSize="11.5" Click="OnLineTemplate"
                                                            ToolTip="Save a strip to paint this line on, true to size (10 px a cm) for its place and width, with front, sides and back marked" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,0,0,0" Visibility="{Binding NoImage, Converter={StaticResource BoolVisible}}">
                                                    <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,6,0" Background="{Binding Swatch}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                                    <TextBox Style="{StaticResource Hex}" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" Tag="color" GotKeyboardFocus="OnLineColorFocus"
                                                             ToolTip="The line's colour" />
                                                    <Border Width="20" Height="20" CornerRadius="5" Margin="14,0,6,0" Background="{Binding EdgeSwatch}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                                    <TextBox Style="{StaticResource Hex}" Text="{Binding EdgeColorText, UpdateSourceTrigger=PropertyChanged}" Tag="edge" GotKeyboardFocus="OnLineColorFocus"
                                                             ToolTip="The edge's colour (blank for none)" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                        <StackPanel x:Name="TabLogos" Visibility="Collapsed">
                            <TextBlock Text="Logos &amp; lettering" Style="{StaticResource TabTitle}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="Every logo and number spot of the kit: move, size, turn, hide or replace it, or add logos of your own anywhere." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" Click="OnAddLogo"
                                        ToolTip="Put a new logo anywhere on the jersey (PNG or DDS; transparency works best). It's painted into the jersey's base.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" />
                                        <TextBlock Text="Add a logo…" Margin="5,0,0,0" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="ON THE TEXTURE  ·  drag, scroll to size" Style="{StaticResource SectionHead}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border CornerRadius="8" Background="{StaticResource Checker}" ClipToBounds="True" HorizontalAlignment="Left">
                                <Grid Width="400" Height="400">
                                    <Image x:Name="StudioSheet" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas x:Name="StudioSpots" Background="Transparent" ClipToBounds="True"
                                            MouseLeftButtonDown="OnSheetDown" MouseMove="OnSheetMove" MouseLeftButtonUp="OnSheetUp" MouseWheel="OnSheetWheel" />
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="StudioSpotList" Margin="0,8,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:SpotRow}">
                                        <Border x:Name="Bd" Margin="0,0,5,5" Padding="8,3" CornerRadius="999" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnSpotChip">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Tx" Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Text}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="SpotEditor" Padding="10,8" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="SpotEnabled" DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Shown" Click="OnSpotEnabled" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock x:Name="SpotTitle" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SpotMeta" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Across" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider x:Name="SpotX" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.002" LargeChange="0.02" ValueChanged="OnSpotSlider" Margin="0,3" />
                                        <TextBlock x:Name="SpotXText" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="Down" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider x:Name="SpotY" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.002" LargeChange="0.02" ValueChanged="OnSpotSlider" Margin="0,3" />
                                        <TextBlock x:Name="SpotYText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider x:Name="SpotSize" Grid.Row="2" Grid.Column="1" Minimum="0.005" Maximum="0.45" SmallChange="0.002" LargeChange="0.01" ValueChanged="OnSpotSlider" Margin="0,3" />
                                        <TextBlock x:Name="SpotSizeText" Grid.Row="2" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="Turn" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider x:Name="SpotTurn" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" ValueChanged="OnSpotSlider" Margin="0,3" />
                                        <TextBlock x:Name="SpotTurnText" Grid.Row="3" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button x:Name="SpotReplace" Style="{StaticResource Ghost}" Content="Replace logo…" Padding="8,4" Click="OnSpotReplace"
                                                ToolTip="A new image for this logo (PNG or DDS; transparency works best)" />
                                        <Button x:Name="SpotCrest" Style="{StaticResource Ghost}" Content="Use crest" Padding="8,4" Click="OnSpotCrest"
                                                ToolTip="Put the kit's main crest (branding layer 0) in this spot's layer" />
                                        <Button Style="{StaticResource Ghost}" Content="Mirror" Padding="8,4" Click="OnSpotMirror" ToolTip="Move it to the same place on the other side" />
                                        <Button x:Name="SpotResetButton" Style="{StaticResource Ghost}" Content="Reset" Padding="8,4" Click="OnSpotReset" ToolTip="Back to where the kit has it" />
                                        <Button x:Name="SpotRemove" Style="{StaticResource Ghost}" Content="Remove" Padding="8,4" Click="OnSpotRemove" ToolTip="Take this added logo off" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <StackPanel x:Name="TabMenu" Visibility="Collapsed">
                            <TextBlock Text="Team menu" Style="{StaticResource TabTitle}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="Add the design to any team as a new slot in its jersey menu: it goes into a free kit folder, so no other jersey changes." />
                            <Border Padding="12,10" CornerRadius="10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,4,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="SlotInfo" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Team" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="SlotTeam" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" MaxDropDownHeight="420" SelectionChanged="OnSlotTargetChanged">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Text="Kit folder" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   ToolTip="The game's files the design is written into. A free folder is one no team's jersey menu shows, so nothing else changes." />
                                        <ComboBox x:Name="SlotFolder" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" DisplayMemberPath="Label" MaxDropDownHeight="420" SelectionChanged="OnSlotTargetChanged">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Text="Menu name" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <ComboBox x:Name="SlotLabel" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" DisplayMemberPath="Label" Margin="0,0,0,8" />
                                        <UniformGrid Grid.Row="3" Grid.Column="1" Columns="2" Margin="0,0,0,8">
                                            <CheckBox x:Name="SlotLight" Style="{StaticResource Switch}" Content="Light" Margin="0,0,0,6"
                                                      ToolTip="A light (white) jersey, which the game picks for away teams" />
                                            <CheckBox x:Name="SlotTop" Style="{StaticResource Switch}" Content="First in menu" Margin="0,0,0,6" />
                                            <CheckBox x:Name="SlotShowUsed" Style="{StaticResource Switch}" Content="Used folders" Click="OnSlotShowUsed"
                                                      ToolTip="List every kit folder. Writing into one a team uses changes that team's jersey too." />
                                            <CheckBox x:Name="SlotOutfit" Style="{StaticResource Switch}" Content="Pants &amp; socks" IsChecked="True"
                                                      ToolTip="Also write the start kit's pants (with their logos) and socks into the folder, so the slot is the whole uniform" />
                                        </UniformGrid>
                                    </Grid>
                                    <DockPanel>
                                        <Button x:Name="SlotWrite" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,6" Click="OnAddToTeam" IsEnabled="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" />
                                                <TextBlock Text="Write &amp; add to team" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SlotExport" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="12,6" Margin="0,0,8,0"
                                                Click="OnExportToMod" IsEnabled="False" Visibility="Collapsed"
                                                ToolTip="Save this uniform into the mod's source folder for the picked team (Home, Away or Third by Menu name). Installing the mod writes it into the game.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" />
                                                <TextBlock Text="Export to mod" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="SlotStatus" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
