<UserControl x:Class="NHL27Kit.App.RosterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NHL27Kit.App">
    <UserControl.Resources>
        <!-- one editable value: label, box, and for ratings a bar -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type local:FieldEdit}">
            <Border x:Name="Bd" Width="{Binding CardWidth}" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <TextBox DockPanel.Dock="Right" Width="{Binding BoxWidth}"
                             Height="30" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="{Binding TextAlign}"
                             FontWeight="SemiBold" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDim}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left" Width="120" Height="4"
                              Visibility="{Binding IsRating, Converter={StaticResource BoolVisible}}">
                            <Border CornerRadius="2" Background="{StaticResource Surface3}" />
                            <Border CornerRadius="2" Background="{Binding BarBrush}" Width="{Binding Bar}" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,3,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PatchSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <!-- one value shown but never edited: same card as a field, faded out (the theme has no disabled
             look for text boxes, so the card itself is dimmed) -->
        <DataTemplate x:Key="ReadOnlyTemplate" DataType="{x:Type local:ReadOnlyField}">
            <Border Width="{Binding CardWidth}" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Opacity="0.6">
                <DockPanel>
                    <TextBox DockPanel.Dock="Right" Width="{Binding BoxWidth}"
                             Height="30" Text="{Binding Text, Mode=OneWay}" IsEnabled="False" HorizontalContentAlignment="Right"
                             FontWeight="SemiBold" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDim}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- one position: primary and secondary dropdowns -->
        <DataTemplate x:Key="PositionTemplate" DataType="{x:Type local:PositionEdit}">
            <Border x:Name="Bd" Width="300" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Primary position" Foreground="{StaticResource TextDim}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding PrimaryChoices}" SelectedItem="{Binding Primary}" DisplayMemberPath="Name" Margin="0,5,0,10" />
                    <TextBlock Text="Secondary position" Foreground="{StaticResource TextDim}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding SecondaryChoices}" SelectedItem="{Binding Secondary}" DisplayMemberPath="Name" Margin="0,5,0,6" />
                    <TextBlock Text="{Binding Display, StringFormat='Plays as {0}'}" Foreground="{StaticResource Muted}" FontSize="11.5" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,3,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PatchSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- one team picker: the team that drafted the player -->
        <DataTemplate x:Key="PickTemplate" DataType="{x:Type local:PickEdit}">
            <Border x:Name="Bd" Width="330" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDim}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Picks}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,3,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PatchSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- one 0/1 flag as a checkbox -->
        <DataTemplate x:Key="ToggleTemplate" DataType="{x:Type local:ToggleEdit}">
            <Border x:Name="Bd" Width="236" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <CheckBox IsChecked="{Binding BoolValue}" Content="{Binding Label}" VerticalAlignment="Center" Foreground="{StaticResource Text}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PatchSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- one year of trade protection: clause type + team list -->
        <DataTemplate x:Key="ClauseTemplate" DataType="{x:Type local:ClauseEdit}">
            <Border x:Name="Bd" Width="300" Margin="0,0,10,10" Padding="12,9" CornerRadius="9" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding YearLabel}" Foreground="{StaticResource TextDim}" FontSize="12" />
                    <ComboBox ItemsSource="{x:Static local:ClauseEdit.Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Margin="0,5,0,8" />
                    <DockPanel>
                        <TextBlock Text="Teams on the list" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Right" Width="70" Height="30" Text="{Binding TeamsField.Text, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Right" FontWeight="SemiBold" IsEnabled="{Binding TeamsEnabled}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" Margin="0,3,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolVisible}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Patch}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PatchSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="9" Padding="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModePlayers" Style="{StaticResource Segment}" GroupName="RosterMode" Content="Players" IsChecked="True" Checked="OnModeChanged" />
                        <RadioButton x:Name="ModeText" Style="{StaticResource Segment}" GroupName="RosterMode" Content="Text" Checked="OnModeChanged" />
                        <RadioButton x:Name="ModeLines" Style="{StaticResource Segment}" GroupName="RosterMode" Content="Lines" Checked="OnModeChanged" />
                        <RadioButton x:Name="ModePicks" Style="{StaticResource Segment}" GroupName="RosterMode" Content="Draft Picks" Checked="OnModeChanged" />
                    </StackPanel>
                </Border>
                <Button x:Name="ReloadButton" Margin="10,0,0,0" Click="OnReload" ToolTip="Read the database from the game files again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Reload" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="PortraitsButton" Margin="10,0,0,0" Click="OnPortraits"
                        ToolTip="Add portraits from NHL.com (via CapWages) for the selected team's players who have none">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Portraits" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="SyncButton" Style="{StaticResource Primary}" Margin="10,0,0,0" Click="OnSyncClick" ToolTip="Bring the game's rosters up to date with the NHL">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="NHL Sync" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="Roster" Style="{StaticResource Title}" />
                <TextBlock x:Name="Summary" Text="Waiting for the asset index…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ NHL sync -->
        <local:RosterSyncView x:Name="SyncView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
        <local:LinesView x:Name="LinesView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
        <local:DraftPicksView x:Name="PicksView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />

        <Grid x:Name="SearchRow" Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Search players — name, team, position, #jersey" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="TeamFilter" Grid.Column="1" Width="230" Margin="12,0,0,0" SelectionChanged="OnTeamChanged" />
            <ComboBox x:Name="LanguageFilter" Grid.Column="1" Width="230" Margin="12,0,0,0" SelectionChanged="OnLanguageChanged" Visibility="Collapsed" />
        </Grid>

        <!-- ============================================================ players -->
        <Grid x:Name="PlayersView" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="ListCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="PLAYERS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="PlayerList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnPlayerSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PlayerRow}">
                                <Grid Height="46" Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Surface3}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Overall}" FontWeight="Bold" FontSize="13" Foreground="{Binding OverallBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <DockPanel x:Name="Editor" Visibility="Collapsed">
                        <!-- save bar -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12" Background="{StaticResource Surface}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscard" IsEnabled="False" />
                                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnSave" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                            <TextBlock x:Name="SaveLabel" Text="Save to game" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="EditState" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- hero -->
                                <Grid Height="232">
                                    <Border x:Name="HeroBg" CornerRadius="12,12,0,0" />
                                    <Border CornerRadius="12,12,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.45" />
                                                <GradientStop Color="#CC14181F" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Image x:Name="Portrait" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="226" Margin="0,0,18,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel x:Name="NoPortrait" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,90,0" Visibility="Collapsed">
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="64" Foreground="#55FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="NoPortraitText" Text="No portrait" Foreground="#88FFFFFF" FontSize="11.5" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,20">
                                        <Border x:Name="TeamPill" CornerRadius="999" Padding="10,3" Background="#33000000" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TeamText" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock x:Name="FirstText" Foreground="#DDFFFFFF" FontSize="17" Margin="0,10,0,0" />
                                        <TextBlock x:Name="LastText" Foreground="White" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" Margin="0,-4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border CornerRadius="8" Padding="10,4" Background="#55000000">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="OverallText" Foreground="White" FontWeight="Bold" FontSize="15" />
                                                    <TextBlock Text="OVR" Foreground="#AAFFFFFF" FontSize="10.5" FontWeight="SemiBold" Margin="6,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="MetaText" Foreground="#CCFFFFFF" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <!-- the player's X-Factor icons, as the game shows them -->
                                            <ItemsControl x:Name="XFactorBadges" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:XFactorSlot}">
                                                        <Image Source="{Binding Icon}" Width="34" Height="34" Margin="0,0,4,0" ToolTip="{Binding Name}"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="20,18,10,10">
                                    <StackPanel x:Name="XFactorSection">
                                        <TextBlock x:Name="XFactorTitle" Text="X-FACTORS" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                                        <ItemsControl x:Name="XFactorList" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:XFactorSlot}">
                                                    <Border x:Name="Card" Width="300" Margin="0,0,10,10" Padding="12" CornerRadius="10" Background="{StaticResource Surface2}"
                                                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,12,0">
                                                                    <Border x:Name="EmptyIcon" CornerRadius="10" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                                                            Visibility="Collapsed" />
                                                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14" />
                                                                    <Border x:Name="TierPill" CornerRadius="999" Padding="8,1" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                            Background="{Binding TierBrush}">
                                                                        <TextBlock Text="{Binding TierName}" Foreground="#E6000000" FontSize="10.5" FontWeight="Bold" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Short}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <DockPanel Margin="0,10,0,0">
                                                                <ComboBox x:Name="TierBox" DockPanel.Dock="Right" Width="96" Margin="8,0,0,0" ItemsSource="{Binding TierNames}"
                                                                          SelectedIndex="{Binding TierIndex}" ToolTip="Tier: Specialist (gold), All-Star (blue), Elite (red)" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"
                                                                          ToolTip="{Binding Slot, StringFormat=X-Factor slot {0}}" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter TargetName="EmptyIcon" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="TierPill" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TierBox" Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Patch}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="IDENTITY" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                                    <ItemsControl x:Name="IdentityFields" ItemTemplate="{StaticResource FieldTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                    <StackPanel x:Name="PositionSection">
                                        <TextBlock Text="POSITION" Style="{StaticResource Overline}" Margin="0,12,0,10" />
                                        <ItemsControl x:Name="PositionList" ItemTemplate="{StaticResource PositionTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                    </StackPanel>
                                    <StackPanel x:Name="DraftSection">
                                        <TextBlock Text="DRAFT" Style="{StaticResource Overline}" Margin="0,12,0,10" />
                                        <ItemsControl x:Name="DraftFields" ItemTemplate="{StaticResource FieldTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                        <ItemsControl x:Name="DraftTeamList" ItemTemplate="{StaticResource PickTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="ContractSection">
                                        <TextBlock Text="CONTRACT" Style="{StaticResource Overline}" Margin="0,12,0,10" />
                                        <TextBlock x:Name="ContractStatusText" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                        <ItemsControl x:Name="ContractFields" ItemTemplate="{StaticResource FieldTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                        <ItemsControl x:Name="ContractToggles" ItemTemplate="{StaticResource ToggleTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" Margin="0,2,0,0" />
                                        <StackPanel x:Name="RetainedSection" Visibility="Collapsed">
                                            <TextBlock Text="RETAINED SALARY" Style="{StaticResource Overline}" Margin="0,12,0,10" />
                                            <TextBlock x:Name="RetainedNote" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                            <ItemsControl x:Name="RetainedFields" ItemTemplate="{StaticResource ReadOnlyTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                        </StackPanel>
                                        <StackPanel x:Name="ClauseSection">
                                            <TextBlock Text="TRADE PROTECTION" Style="{StaticResource Overline}" Margin="0,12,0,6" />
                                            <TextBlock Text="One clause per season, starting with this season — through the contract, then the extension. A team list only applies with a clause." Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                            <ItemsControl x:Name="ClauseList" ItemTemplate="{StaticResource ClauseTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="RatingsTitle" Text="RATINGS" Style="{StaticResource Overline}" Margin="0,12,0,10" />
                                    <ItemsControl x:Name="RatingFields" ItemTemplate="{StaticResource FieldTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <StackPanel x:Name="EditorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a player" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Ratings, names and numbers are read from the game files each time you select one, and saved straight back into them."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ text -->
        <Grid x:Name="TextView" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock x:Name="TextCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="STRINGS" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="TextList" Background="Transparent" BorderThickness="0" Padding="6,0,4,6" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnTextSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LocRow}">
                                <StackPanel Margin="6,7">
                                    <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource Faint}" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <DockPanel x:Name="TextEditor" Margin="18,16" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="STRING ID" Style="{StaticResource Overline}" />
                        <TextBlock x:Name="TextId" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="12" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Grid Height="6" Margin="0,0,0,6">
                                <Border CornerRadius="3" Background="{StaticResource Surface3}" />
                                <Border x:Name="BudgetBar" CornerRadius="3" Background="{StaticResource Accent}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BudgetScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="BudgetText" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="TextRevert" Content="Revert" Click="OnTextRevert" IsEnabled="False" />
                                    <Button x:Name="TextSave" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnTextSave" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                                            <TextBlock Text="Save to game" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TextState" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TEXT" Style="{StaticResource Overline}" Margin="0,16,0,6" />
                        <TextBox x:Name="TextBody" Height="Auto" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Padding="10,8" VerticalScrollBarVisibility="Auto" TextChanged="OnTextBodyChanged" />
                    </DockPanel>
                    <StackPanel x:Name="TextEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Pick a string" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="Menu text, commentary captions and names, per language. Edits are written into the game's language database."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
